# Multi-Bot Configuration Example
# 
# Для каждого бота создайте переменные с префиксом имени бота
# Например, для бота "bot1" используйте TELEGRAM_BOT_TOKEN_bot1, GSHEET_ID_bot1 и т.д.
#
# Если переменные с префиксом не найдены, используются переменные без префикса
# (для обратной совместимости)

# ============================================
# СПИСОК БОТОВ (опционально)
# ============================================
# Если не указано, боты определяются автоматически по наличию TELEGRAM_BOT_TOKEN_{bot_name}
BOTS_LIST=bot1,bot2,bot3

# ============================================
# БОТ 1 (bot1)
# ============================================
# Telegram
TELEGRAM_BOT_TOKEN_bot1=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_IDS_bot1=123456789,987654321

# База данных
DATABASE_PATH_bot1=bot1.db

# Google Sheets
GSHEET_ID_bot1=1a2b3c4d5e6f7g8h9i0j
GSHEET_COURSES_NAME_bot1=Courses
GSHEET_TEXTS_NAME_bot1=Texts
GOOGLE_SHEETS_USE_API_bot1=False
GOOGLE_CREDENTIALS_FILE_bot1=google_credentials.json

# Оплата YooKassa
PAYMENT_PROVIDER_TOKEN_bot1=123456:TEST:abcdefghijklmnopqrstuvwxyz
CURRENCY_bot1=RUB

# Оплата Prodamus
ENABLE_PRODAMUS_bot1=True
PRODAMUS_TEST_MODE_bot1=True
PRODAMUS_PAYFORM_URL_bot1=testwork1.payform.ru
PRODAMUS_SECRET_KEY_bot1=your_secret_key_here
PRODAMUS_SYSTEM_ID_bot1=your_system_id_here
PRODAMUS_TEST_WEBHOOK_URL_bot1=

# Webhook (PythonAnywhere)
USE_WEBHOOK_bot1=True
WEBHOOK_HOST_bot1=yourusername.pythonanywhere.com
WEBHOOK_PATH_bot1=/webhook/bot1
WEBHOOK_SECRET_TOKEN_bot1=your_secret_token_here

# ============================================
# БОТ 2 (bot2)
# ============================================
# Telegram
TELEGRAM_BOT_TOKEN_bot2=987654321:ZYXwvuTSRqpoNMLkjihGFEdcba
ADMIN_IDS_bot2=111222333,444555666

# База данных
DATABASE_PATH_bot2=bot2.db

# Google Sheets
GSHEET_ID_bot2=9z8y7x6w5v4u3t2s1r0q
GSHEET_COURSES_NAME_bot2=Courses
GSHEET_TEXTS_NAME_bot2=Texts
GOOGLE_SHEETS_USE_API_bot2=False
GOOGLE_CREDENTIALS_FILE_bot2=google_credentials.json

# Оплата YooKassa
PAYMENT_PROVIDER_TOKEN_bot2=987654:TEST:zyxwvutsrqponmlkjihgfedcba
CURRENCY_bot2=RUB

# Оплата Prodamus
ENABLE_PRODAMUS_bot2=True
PRODAMUS_TEST_MODE_bot2=True
PRODAMUS_PAYFORM_URL_bot2=testwork1.payform.ru
PRODAMUS_SECRET_KEY_bot2=your_secret_key_here_bot2
PRODAMUS_SYSTEM_ID_bot2=your_system_id_here_bot2
PRODAMUS_TEST_WEBHOOK_URL_bot2=

# Webhook (PythonAnywhere)
USE_WEBHOOK_bot2=True
WEBHOOK_HOST_bot2=yourusername.pythonanywhere.com
WEBHOOK_PATH_bot2=/webhook/bot2
WEBHOOK_SECRET_TOKEN_bot2=your_secret_token_here_bot2

# ============================================
# БОТ 3 (bot3) - пример минимальной конфигурации
# ============================================
# Telegram
TELEGRAM_BOT_TOKEN_bot3=555666777:ABC123DEF456GHI789
ADMIN_IDS_bot3=777888999

# База данных (по умолчанию будет bot3.db)
# DATABASE_PATH_bot3=bot3.db

# Google Sheets
GSHEET_ID_bot3=1q2w3e4r5t6y7u8i9o0p

# Оплата YooKassa
PAYMENT_PROVIDER_TOKEN_bot3=555666:TEST:1234567890abcdef

# Webhook (PythonAnywhere)
USE_WEBHOOK_bot3=True
WEBHOOK_HOST_bot3=yourusername.pythonanywhere.com
WEBHOOK_PATH_bot3=/webhook/bot3

# ============================================
# ОБРАТНАЯ СОВМЕСТИМОСТЬ
# ============================================
# Эти переменные используются, если переменные с префиксом не найдены
# Например, если TELEGRAM_BOT_TOKEN_bot1 не найден, используется TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_IDS=123456789
DATABASE_PATH=bot.db
GSHEET_ID=1a2b3c4d5e6f7g8h9i0j
PAYMENT_PROVIDER_TOKEN=123456:TEST:abcdefghijklmnopqrstuvwxyz
USE_WEBHOOK=True
WEBHOOK_HOST=yourusername.pythonanywhere.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET_TOKEN=your_secret_token_here

