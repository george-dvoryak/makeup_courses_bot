# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Payment Providers
PAYMENT_PROVIDER_TOKEN=your_yookassa_provider_token_here
CURRENCY=RUB


# Database
DATABASE_PATH=bot.db

# Google Sheets
GSHEET_ID=your_google_sheet_id_here
GSHEET_COURSES_NAME=Courses
GSHEET_TEXTS_NAME=Texts
GOOGLE_SHEETS_USE_API=False
GOOGLE_CREDENTIALS_FILE=google_credentials.json

# Admins (comma-separated Telegram user IDs)
ADMIN_IDS=123456789,987654321

# Webhook (for PythonAnywhere)
USE_WEBHOOK=False
WEBHOOK_HOST=your_username.pythonanywhere.com
WEBHOOK_PATH=/your_webhook_path
WEBHOOK_SECRET_TOKEN=
WEBHOOK_URL=
